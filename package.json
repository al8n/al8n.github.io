{
  "name": "al8n.github.io",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/verify-build.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check",
    "build:offline": "node scripts/build-offline.mjs && node scripts/verify-build.mjs",
    "preview:offline": "node scripts/serve.mjs",
    "resume:data": "node scripts/export-resume.mjs",
    "resume": "node scripts/export-resume.mjs && python3 scripts/generate-public-resume.py",
    "verify": "node scripts/verify-build.mjs",
    "verify:privacy": "node scripts/verify-public-content.mjs",
    "test": "node --test scripts/site.test.mjs",
    "test:browser": "node scripts/browser-qa.mjs",
    "verify:links": "node scripts/verify-links.mjs"
  },
  "dependencies": { "astro": "6.0.0" },
  "devDependencies": { "@astrojs/check": "0.9.4", "typescript": "5.9.2", "playwright": "1.56.1" }
}
